{
	"name": "n8n-nodes-anysearch",
	"version": "0.1.0",
	"description": "n8n community nodes for AnySearch: unified web search, vertical capability search, and URL content extraction",
	"license": "MIT",
	"homepage": "https://github.com/MCapricorns/n8n-nodes-anysearch#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"anysearch",
		"search",
		"web-search"
	],
	"author": {
		"name": "MCapricorns",
		"email": "MCapricorns@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MCapricorns/n8n-nodes-anysearch.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AnySearchApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AnySearch/AnySearch.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
